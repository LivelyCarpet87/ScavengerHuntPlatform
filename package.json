{
  "name": "scavenger-hunt-platform",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run sw:build && next dev",
    "build": "bun run sw:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test",
    "e2e": "bun test --root ./e2e --timeout 120000",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "sw:build": "bun build sw/index.ts --outfile public/sw.js --target browser --minify",
    "icons": "bun scripts/generate-icons.ts",
    "shot": "bun scripts/shot.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "clsx": "^2.1.1",
    "d3-contour": "^4.0.2",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "file-type": "^22.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
