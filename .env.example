# Copy to .env.local and adjust. Every value is optional.

# Public URL of this app. Used for QR codes, share links and push notifications.
# When unset, links are built from the incoming request's host.
# APP_URL=https://hunt.example.com

# Name shown in the header, manifest and browser tab.
# APP_NAME=Scavenger

# Where the SQLite database and uploaded photos/videos live.
# DATA_DIR=./data

# Use a remote libSQL/Turso database instead of the local file.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Largest photo/video a team can upload, in megabytes.
# MAX_UPLOAD_MB=100

# Web push keys. Generated automatically on first boot and stored in the
# database when unset; set them to keep subscriptions valid across databases.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Force Secure cookies on/off. Defaults to on when APP_URL starts with https.
# COOKIE_SECURE=true

# Proxies in front of the app that add to X-Forwarded-For (2 for a CDN in
# front of Caddy or nginx). Rate limits use the address the outermost one saw.
# TRUSTED_PROXY_HOPS=1
